{
  "name": "wali-dsh-plugin",
  "description": "Desktop pet surface: a free-roaming, conversation-aware pet that floats over the whole dsh web UI",
  "version": "0.1.4",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "prepublishOnly": "pnpm run bundle"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "web-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzhengwei/wali-dsh-plugin.git"
  },
  "homepage": "https://github.com/fuzhengwei/wali-dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/fuzhengwei/wali-dsh-plugin/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.31",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  }
}
